# Generate a random secret of at least 24 characters for /reports.html.
DEMO_ADMIN_KEY=
# Optional comma-separated owner IPs. Presenter mode excludes a browser without this.
DEMO_EXCLUDED_IPS=
# Connect a PUBLIC Blob store for uploaded demo logos used in share links.
DEMO_LOGO_BLOB_READ_WRITE_TOKEN=
